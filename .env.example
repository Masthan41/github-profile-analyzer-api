PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=github_profile_analyzer

# Optional but recommended to increase GitHub API rate limits.
GITHUB_TOKEN=

# Number of repository pages to inspect for deeper insights.
# 1 page = up to 100 public repositories.
GITHUB_REPO_PAGE_LIMIT=3
